{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/crypto-due-diligence/data/schema.json",
  "title": "Crypto/NFT/points due-diligence record",
  "description": "One file per project at data/projects/<slug>.json. Generated by tools/build.py; edit tools/data_*.py instead. The 10 required reader fields are documented in x_reader_fields.",
  "type": "object",
  "additionalProperties": false,
  "x_reader_fields": [
    {
      "n": "1",
      "field": "project + X link",
      "keys": [
        "name",
        "aliases",
        "links.x"
      ]
    },
    {
      "n": "2",
      "field": "interest level",
      "keys": [
        "score.interest",
        "field2_interest"
      ]
    },
    {
      "n": "3",
      "field": "credibility / trust",
      "keys": [
        "score.trust",
        "trust_evidence[]"
      ]
    },
    {
      "n": "4",
      "field": "model / architecture",
      "keys": [
        "model",
        "legal_entity",
        "chain"
      ]
    },
    {
      "n": "5",
      "field": "how to play or invest",
      "keys": [
        "how_to_play[]"
      ]
    },
    {
      "n": "6",
      "field": "risks",
      "keys": [
        "risks[]"
      ]
    },
    {
      "n": "7",
      "field": "value for money",
      "keys": [
        "value_for_money",
        "house_edge[]",
        "cost_of_entry_usd"
      ]
    },
    {
      "n": "8",
      "field": "opportunity + returns",
      "keys": [
        "opportunity",
        "returns[]",
        "max_sane_budget_usd",
        "capital_rule"
      ]
    },
    {
      "n": "9",
      "field": "history + technical/on-chain",
      "keys": [
        "history[]",
        "technical",
        "verified_on"
      ]
    },
    {
      "n": "10",
      "field": "short verdict",
      "keys": [
        "verdict_short",
        "status",
        "rank"
      ]
    }
  ],
  "required": [
    "slug",
    "name",
    "links",
    "score",
    "field2_interest",
    "trust_evidence",
    "model",
    "how_to_play",
    "risks",
    "value_for_money",
    "house_edge",
    "opportunity",
    "returns",
    "history",
    "technical",
    "verdict_short",
    "unverified",
    "watch",
    "sources",
    "status",
    "rank",
    "legal_entity",
    "chain",
    "stale_risk",
    "verified_on",
    "cost_of_entry_usd",
    "max_sane_budget_usd",
    "capital_rule",
    "needs_recheck",
    "schema_version"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "schema_version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "required": [
        "x"
      ],
      "properties": {
        "x": {
          "type": [
            "string",
            "null"
          ],
          "description": "official X/Twitter URL or null when the handle was never confirmed"
        },
        "site": {
          "type": [
            "string",
            "null"
          ]
        },
        "docs": {
          "type": [
            "string",
            "null"
          ]
        },
        "api": {
          "type": [
            "string",
            "null"
          ]
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "chain": {
      "type": "string"
    },
    "legal_entity": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "required": [
        "interest",
        "trust"
      ],
      "properties": {
        "interest": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "trust": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "breakdown": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "field2_interest": {
      "type": "string"
    },
    "trust_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "only self-verified observations (RPC/source/market/API). Platform marketing must not appear here."
    },
    "model": {
      "type": "string"
    },
    "how_to_play": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "value_for_money": {
      "type": "string"
    },
    "house_edge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "machine": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          },
          "ev_usd": {
            "type": "number"
          },
          "ev_over_price": {
            "type": "string"
          },
          "instant_flip_net_pct": {
            "type": "number"
          },
          "value": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "tier_buyback_floor_usd": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "cost_of_entry_usd": {
      "type": "number",
      "minimum": 0
    },
    "opportunity": {
      "type": "string"
    },
    "returns": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "budget_usd"
        ],
        "properties": {
          "budget_usd": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "expected_usd": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "max_sane_budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "capital_rule": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "technical": {
      "type": "object",
      "required": [
        "onchain"
      ],
      "properties": {
        "onchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "item",
              "finding"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "addr": {
                "type": "string"
              },
              "finding": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "api_endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accounts": {
          "type": "object"
        },
        "market": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "verdict_short": {
      "type": "string",
      "minLength": 20
    },
    "unverified": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "watch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "needs_recheck": {
      "type": "boolean"
    },
    "stale_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "stale_risk_note": {
      "type": "string",
      "description": "what exactly goes stale and how fast"
    },
    "verified_on": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "generated_from": {
      "type": "string"
    }
  }
}
